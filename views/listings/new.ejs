    <%- layout('layouts/boilerplate') %>
    <div class="row">
        <div class="col-8 offset-2">
            <br><br>
        <h3 class="text-center">Add your Listing</h3>
        <br>
        <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label">Enter Title</label>
            <input 
            name="listing[title]" 
            type="text" 
            placeholder="Add a catchy title" 
            class="form-control"
            required
            />
            <div class="valid-feedback">Title looks good!</div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" class="form-control" required></textarea> 
            <div class="invalid-feedback">Description!</div>
            <!-- placeholder="enter desc -->
        </div>
        
        <!-- <div class="mb-3">
            <label for="image" class="form-label">Image Link</label>
            <input 
                name="listing[image]" 
                type="text" 
                placeholder="enter image URL"
                class="form-control"
                />
        </div> -->
        <div class="mb-3">
            <label for="image" class="form-label">Upload Image</label>
            <input 
                name="listing[image]" 
                type="file" 
                class="form-control"
                required
                />
        </div>
        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="title" class="form-label">Price</label>
                <input name="listing[price]" 
                placeholder="1200" 
                type="number"
                class="form-control"
                required
                >
                <div class="invalid-feedback">Invalid Input!</div>
            </div>
        
            <div class="mb-3 col-md-8">
                <label for="country" class="form-label">Country</label>
                <input name="listing[country]" placeholder="India" type="text" class="form-control" required>
                <div class="invalid-feedback">Invalid Country name!</div>
            </div>
        </div>
        
        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" placeholder="Lucknow, Uttar Pradesh" type="text" class="form-control" required>
            <div class="invalid-feedback">Invalid Location!</div>
        </div>
        <br>
        <div class="d-flex justify-content-center">
            <button class="btn btn-dark add-btn text-center">Submit</button>
        </div>
    </form>
    <br>
    </div>
</div>
    